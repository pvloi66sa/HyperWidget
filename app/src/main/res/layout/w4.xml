<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:gravity="center" android:background="@drawable/bg_dark">
<TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="44sp" android:fontFamily="sans-serif-light" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:includeFontPadding="false" /><TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="40sp" android:includeFontPadding="false" android:layout_marginTop="6dp"/><TextView android:id="@+id/temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:includeFontPadding="false" /><TextView android:id="@+id/cond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" /><TextView android:id="@+id/lday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="34sp" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="12dp"/><TextView android:id="@+id/lmonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" /><TextView android:id="@+id/canchi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:includeFontPadding="false" android:gravity="center" android:maxLines="2"/><TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:includeFontPadding="false" android:layout_marginTop="4dp"/><TextView android:id="@+id/lunar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="1sp" android:includeFontPadding="false" android:visibility="gone"/><TextView android:id="@+id/extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="1sp" android:includeFontPadding="false" android:visibility="gone"/>
</LinearLayout>
