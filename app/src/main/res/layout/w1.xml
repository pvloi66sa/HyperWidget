includeFontPadding="false" android:visibility="gone"/><TextView android:id="@+id/canchi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="1sp" android:includeFontPadding="false" android:visibility="gone"/><TextView android:id="@+id/extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="1sp" android:includeFontPadding="false" android:visibility="gone"/>
